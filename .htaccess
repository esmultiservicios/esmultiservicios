Options -Indexes
DirectoryIndex index.php

# Production is deployed directly to the domain DocumentRoot (public_html).
# Do not redirect between / and /esmultiservicios.com/ here: doing so can
# conflict with a hosting-level redirect and create ERR_TOO_MANY_REDIRECTS.
<IfModule mod_rewrite.c>
  RewriteEngine On
</IfModule>

<FilesMatch "^(database\.sql|database-update\.sql|\.gitignore|\.cpanel\.yml)$">
  Require all denied
</FilesMatch>
