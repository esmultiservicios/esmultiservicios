Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical public URLs. If a cPanel Git checkout folder named like the
  # domain appears in the request, remove it from the browser URL.
  RewriteCond %{HTTP_HOST} ^(?:www\.)?esmultiservicios\.com$ [NC]
  RewriteRule ^esmultiservicios\.com(?:/(.*))?$ /$1 [R=301,L,NE]
</IfModule>

<FilesMatch "^(database\.sql|database-update\.sql|README\.txt|\.gitignore|\.cpanel\.yml)$">
  Require all denied
</FilesMatch>
